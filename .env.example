# OpenAI API Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here

# WhatsApp Business API Configuration
WHATSAPP_TOKEN=your-whatsapp-business-api-token
WHATSAPP_PHONE_ID=your-phone-number-id
